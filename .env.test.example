# ─────────────────────────────────────────────────────────────────────────────
# Zebri — Test environment template
#
# Copy to `.env.test` and fill in. Used by the e2e suite (and, from Phase 0.3,
# the integration suite running against a LOCAL Supabase stack).
# NEVER point TEST_* credentials at a real user or the production project.
# ─────────────────────────────────────────────────────────────────────────────

# Seeded test account the e2e suite logs in as.
TEST_EMAIL=                               # (required) e.g. e2e@zebri.test
TEST_PASSWORD=                            # (required)

# Supabase target for tests.
# Phase 0.3 onward this should point at the LOCAL Supabase stack
# (`supabase start` → http://127.0.0.1:54321), NOT a cloud project.
NEXT_PUBLIC_SUPABASE_URL=                 # (required)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # (required) local anon key
