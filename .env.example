# ─────────────────────────────────────────────────────────────────────────────
# Zebri — Local environment template
#
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `NEXT_PUBLIC_*` vars are exposed to the browser; everything else is server-only.
# A var marked (required) must be set for the app to boot/function.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + publishable (anon) key are public; service-role key is SECRET
# and must never reach the browser (server actions / route handlers / webhooks).
NEXT_PUBLIC_SUPABASE_URL=                 # (required) e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # (required) anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=                # (required, SECRET) admin ops, webhooks, shadow-mode

# ── Slack alerting ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                        # (required) incoming webhook for ops/business alerts

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                        # (required, SECRET) Stripe API key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # (required) publishable key — used by the embedded Connect components in /settings?tab=payments
STRIPE_WEBHOOK_SECRET=                    # (required) signing secret for /api/stripe/webhook
STRIPE_CONNECT_WEBHOOK_SECRET=            # (required) signing secret for Connect webhook events
STRIPE_PRO_PRICE_ID=                      # (required) price ID for the Pro plan
STRIPE_MAX_PRICE_ID=                      # (required) price ID for the Max plan

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                           # (required, SECRET) transactional email sends (the default shared Zebri address)
EMAIL_CRED_KEY=                           # (required, SECRET) 32-byte base64 AES key — encrypts MCs' OAuth mailbox tokens at rest (lib/crypto/secret-box). Generate: openssl rand -base64 32

# ── Connect-your-own-mailbox OAuth (Gmail + Outlook) ───────────────
# Google Cloud OAuth client (console.cloud.google.com). Consent screen +
# scopes openid/email/gmail.send; redirect URI <APP_URL>/api/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=                    # (required for Gmail) OAuth client id
GOOGLE_OAUTH_CLIENT_SECRET=                # (required for Gmail, SECRET)
# Azure app registration (portal.azure.com). Delegated Mail.Send permission;
# same redirect URI. Tenant 'common' = work + personal accounts.
MICROSOFT_OAUTH_CLIENT_ID=                 # (required for Outlook)
MICROSOFT_OAUTH_CLIENT_SECRET=             # (required for Outlook, SECRET)
MICROSOFT_OAUTH_TENANT=common              # (optional) defaults to 'common'

# ── Google Places ───────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=                    # (required) venue/address autocomplete + drive-time

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret asserted by /api/cron/* and scheduled email routes to reject
# unauthenticated invocations (Vercel Cron sends it as a bearer token).
CRON_SECRET=                              # (required, SECRET)

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=                      # (required) absolute base URL, e.g. http://localhost:3000
